datasource db {
  provider = "postgresql"
}


generator client {
    provider = "prisma-client-js"
    previewFeatures = ["driverAdapters"]
}

enum Language {
    javascript
    python
    c
    java
    html_css
}

model Session {
    sessionId          String       @id  @default(uuid())
    clientId           String
    sessionName        String       @default("Untitled Session")
    language           Language
    codeInput          String
    aiSummary          String?
    aiIssues           String?
    aiSuggestions      String?
    createdAt          DateTime     @default(now())
}
